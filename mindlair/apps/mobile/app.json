{
  "expo": {
    "name": "Mindlair",
    "slug": "mindlair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mindlair.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Mindlair to access your photos to share content",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["mindlair"]
          }
        ]
      },
      "associatedDomains": ["applinks:mindlair.app"],
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"],
        "com.apple.security.application-groups": ["group.app.mindlair"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "app.mindlair.mobile",
      "intentFilters": [
        {
          "action": "android.intent.action.SEND",
          "category": ["android.intent.category.DEFAULT"],
          "data": [
            { "mimeType": "text/plain" },
            { "mimeType": "text/*" }
          ]
        },
        {
          "action": "android.intent.action.SEND_MULTIPLE",
          "category": ["android.intent.category.DEFAULT"],
          "data": [
            { "mimeType": "text/plain" }
          ]
        },
        {
          "action": "android.intent.action.VIEW",
          "category": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"],
          "data": [
            { "scheme": "mindlair" },
            { "scheme": "https", "host": "mindlair.app", "pathPrefix": "/share" },
            { "scheme": "https", "host": "mindlair.app", "pathPrefix": "/voice-capture" }
          ]
        }
      ],
      "shortcuts": [
        {
          "shortcutId": "voice-capture",
          "shortcutShortLabel": "Voice capture",
          "shortcutLongLabel": "Start voice capture",
          "intents": [
            {
              "action": "android.intent.action.VIEW",
              "data": "mindlair://voice-capture",
              "categories": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"]
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-av",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10b981"
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "voice-capture",
              "title": "Voice capture",
              "subtitle": "Start a new voice note",
              "icon": "symbol:mic.fill",
              "params": { "href": "/voice-capture" }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "scheme": "mindlair"
  }
}
